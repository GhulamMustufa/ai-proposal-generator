# ==========================================
# BACKEND (NestJS API) - apps/api/.env
# ==========================================

# PostgreSQL Database Connection (used by Drizzle ORM)
# Find this in your local Docker Postgres or a provider like Neon/Supabase DB
DATABASE_URL=postgresql://user:password@localhost:5432/ai_proposal_db

# Redis Connection (used by BullMQ for background queues)
# Find this in your local Docker Redis or a provider like Upstash
REDIS_URL=redis://localhost:6379

# OpenAI API Key (used for Proposal/Email generation)
# Find this at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key

# Clerk Secret Key (used to verify Auth tokens in NestJS)
# Find this at: https://dashboard.clerk.com/ -> API Keys
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# Backend Port
PORT=3001


# ==========================================
# FRONTEND (Next.js Web) - apps/web/.env.local
# ==========================================

# Clerk Publishable Key (used for Frontend Auth UI)
# Find this at: https://dashboard.clerk.com/ -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# Backend API URL (used to make fetch requests to NestJS)
NEXT_PUBLIC_API_URL=http://localhost:3001
